#!/usr/bin/env python3
"""Run the same warp as alt+space after Kitty gains focus.

Not a long-lived subscriber. Skip hover and click-to-focus (no recent
Sway keyboard binding), notification clicks (hold-window; those warp via
herdr-warp-on-focus after agent focus), and when pane.focused already warped.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

SKIP_AFTER_PANE_MS = int(os.environ.get("HERDR_WARP_SKIP_AFTER_PANE_MS", "250"))
HOLD_MS = int(os.environ.get("HERDR_WARP_HOLD_MS", "2000"))
BINDING_MS = int(os.environ.get("HERDR_WARP_BINDING_MS", "300"))


def runtime_dir() -> Path:
    if os.environ.get("HERDR_WARP_DIR"):
        return Path(os.environ["HERDR_WARP_DIR"])
    xdg = os.environ.get("XDG_RUNTIME_DIR")
    if xdg:
        return Path(xdg) / "herdr-warp"
    return Path(f"/run/user/{os.getuid()}") / "herdr-warp"


WARP_DIR = runtime_dir()
PROC_ROOT = Path(os.environ.get("HERDR_WARP_PROC_ROOT") or "/proc")
SWAYMSG = os.environ.get("HERDR_WARP_SWAYMSG") or "swaymsg"
WARP_BIN = os.environ.get("HERDR_WARP_ON_FOCUS_BIN") or ""


def enabled() -> bool:
    return os.environ.get("HERDR_WARP_ON_FOCUS", "1").strip().lower() not in {
        "0",
        "false",
        "no",
        "off",
    }


def warp_script() -> Path:
    if WARP_BIN:
        return Path(WARP_BIN)
    return Path(__file__).resolve().parent / "herdr-warp-on-focus"


def run_host(args: list[str], **kwargs) -> subprocess.CompletedProcess[str]:
    kwargs.setdefault("text", True)
    kwargs.setdefault("capture_output", True)
    kwargs.setdefault("check", False)
    if shutil.which(args[0]):
        return subprocess.run(args, **kwargs)
    if Path("/run/.containerenv").is_file() and shutil.which("flatpak-spawn"):
        return subprocess.run(["flatpak-spawn", "--host", *args], **kwargs)
    return subprocess.run(args, **kwargs)


def last_pane_warp_ms() -> int | None:
    try:
        raw = int((WARP_DIR / "last-pane-warp").read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return None
    if raw > 10**15:
        return raw // 1_000_000
    return raw


def window_hold_active(now_ms: int | None = None, hold_ms: int = HOLD_MS) -> bool:
    path = WARP_DIR / "hold-window"
    try:
        raw = int(path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return False
    if now_ms is None:
        now_ms = int(time.time() * 1000)
    return 0 <= now_ms - raw < hold_ms


def recent_pane_warp(now_ms: int | None = None, skip_ms: int = SKIP_AFTER_PANE_MS) -> bool:
    last = last_pane_warp_ms()
    if last is None:
        return False
    if now_ms is None:
        now_ms = int(time.time() * 1000)
    return 0 <= now_ms - last < skip_ms


def last_binding_ms() -> int | None:
    try:
        raw = int((WARP_DIR / "last-binding").read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return None
    if raw > 10**15:
        return raw // 1_000_000
    return raw


def recent_keyboard_binding(now_ms: int | None = None, within_ms: int = BINDING_MS) -> bool:
    last = last_binding_ms()
    if last is None:
        return False
    if now_ms is None:
        now_ms = int(time.time() * 1000)
    return 0 <= now_ms - last < within_ms


def binding_wait_ms() -> int:
    try:
        return int(os.environ.get("HERDR_WARP_BINDING_WAIT_MS", "150"))
    except ValueError:
        return 150


def wait_for_keyboard_binding(
    now_ms: int | None = None,
    within_ms: int = BINDING_MS,
    wait_ms: int | None = None,
) -> bool:
    """Wait briefly so the binding stamper can win the focus race."""
    if recent_keyboard_binding(now_ms=now_ms, within_ms=within_ms):
        return True
    if wait_ms is None:
        wait_ms = binding_wait_ms()
    if wait_ms <= 0:
        return False
    deadline = time.monotonic() + wait_ms / 1000
    while time.monotonic() < deadline:
        time.sleep(0.02)
        if recent_keyboard_binding(within_ms=within_ms):
            return True
    return False


def comm(pid: int) -> str:
    try:
        return (PROC_ROOT / str(pid) / "comm").read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def cmdline(pid: int) -> str:
    try:
        raw = (PROC_ROOT / str(pid) / "cmdline").read_bytes()
    except OSError:
        return ""
    return raw.replace(b"\0", b" ").decode("utf-8", "replace")


def children(pid: int) -> list[int]:
    out: list[int] = []
    task = PROC_ROOT / str(pid) / "task"
    try:
        tids = list(task.iterdir())
    except OSError:
        return out
    for tid in tids:
        try:
            text = (tid / "children").read_text(encoding="utf-8")
        except OSError:
            continue
        out.extend(int(part) for part in text.split() if part.isdigit())
    return out


def looks_like_herdr(pid: int) -> bool:
    name = comm(pid).lower()
    if name == "herdr" or name.startswith("herdr"):
        return True
    return re.search(r"(^|[/\s])herdr(\s|$)", cmdline(pid)) is not None


def kitty_has_herdr(pid: int, depth: int = 3) -> bool:
    seen: set[int] = set()
    queue: list[tuple[int, int]] = [(child, 1) for child in children(pid)]
    while queue:
        current, level = queue.pop()
        if current in seen or level > depth:
            continue
        seen.add(current)
        if looks_like_herdr(current):
            return True
        if level < depth:
            queue.extend((child, level + 1) for child in children(current))
    return False


def title_has_herdr(title: str) -> bool:
    return "herdr" in (title or "").lower()


def decide_action(*, recent_pane: bool, is_herdr: bool, title_herdr: bool) -> str:
    """Return skip or compute (same as alt+space)."""
    if recent_pane:
        return "skip"
    if is_herdr or title_herdr:
        return "compute"
    return "skip"


def focused_tree_pid(tree: object) -> int | None:
    if not isinstance(tree, dict):
        return None
    if tree.get("focused"):
        try:
            pid = int(tree.get("pid") or 0)
        except (TypeError, ValueError):
            return None
        return pid or None
    for child in list(tree.get("nodes") or []) + list(tree.get("floating_nodes") or []):
        found = focused_tree_pid(child)
        if found is not None:
            return found
    return None


def sway_focused_pid() -> int | None:
    forced = os.environ.get("HERDR_WARP_FOCUSED_PID")
    if forced:
        try:
            return int(forced)
        except ValueError:
            return None
    proc = run_host([SWAYMSG, "-t", "get_tree"])
    if proc.returncode != 0 or not proc.stdout:
        return None
    try:
        return focused_tree_pid(json.loads(proc.stdout))
    except json.JSONDecodeError:
        return None


def write_last_run(message: str) -> None:
    WARP_DIR.mkdir(parents=True, exist_ok=True)
    (WARP_DIR / "last-run").write_text(f"{message}\n", encoding="utf-8")


def bump_token() -> str:
    WARP_DIR.mkdir(parents=True, exist_ok=True)
    token = str(time.time_ns())
    (WARP_DIR / "window-pending").write_text(f"{token}\n", encoding="utf-8")
    return token


def current_token() -> str:
    try:
        return (WARP_DIR / "window-pending").read_text(encoding="utf-8").strip()
    except OSError:
        return ""


def with_user_bin(env: dict[str, str]) -> dict[str, str]:
    user_bin = str(Path.home() / ".local/bin")
    path = env.get("PATH", "")
    parts = [part for part in path.split(":") if part]
    if user_bin not in parts:
        env["PATH"] = f"{user_bin}:{path}" if path else user_bin
    return env


def compute_warp(token: str) -> None:
    script = warp_script()
    if not script.is_file():
        return
    env = with_user_bin(os.environ.copy())
    env.setdefault("HERDR_WARP_DIR", str(WARP_DIR))
    env["HERDR_WARP_TOKEN"] = token
    env["HERDR_WARP_TOKEN_FILE"] = str(WARP_DIR / "window-pending")
    subprocess.Popen(
        [str(script)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=env,
        start_new_session=True,
    )


def handle_focused_kitty(pid: int, title: str, token: str) -> str:
    if window_hold_active():
        return "skip hold-window"
    if recent_pane_warp():
        return "skip recent-pane"
    action = decide_action(
        recent_pane=False,
        is_herdr=kitty_has_herdr(pid),
        title_herdr=title_has_herdr(title),
    )
    if action == "skip":
        return "skip not-herdr"
    if not wait_for_keyboard_binding():
        return "skip no-keyboard"
    if current_token() != token:
        return "skip stale-token"
    compute_warp(token)
    return "compute"


def run_focus_in(pid: int, title: str) -> None:
    token = bump_token()
    focused = sway_focused_pid()
    if focused != pid:
        write_last_run(f"skip not-focused pid={pid} focused={focused}")
        return
    write_last_run(f"{handle_focused_kitty(pid, title, token)} pid={pid}")


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--pid", type=int, help="Kitty OS process id that gained focus")
    parser.add_argument("--title", default="", help="Kitty window title")
    parser.add_argument(
        "--cancel",
        action="store_true",
        help="Ignored; leaving Kitty is detected via Sway focus",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    if not enabled():
        return 0
    args = parse_args(argv)
    if args.cancel:
        return 0
    if args.pid is None or args.pid <= 0:
        return 0
    run_focus_in(args.pid, args.title)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        sys.exit(0)
